# ─── Obligatoire en production ───
# Aucune valeur de repli n'existe dans le code : l'application refuse de
# démarrer sans SECRET_KEY (hors dev/test).
# Générer avec :  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true en production (HTTPS). false pour le développement local en HTTP.
SESSION_COOKIE_SECURE=true
# Lax : la session fonctionne en cross-site pour l'app mobile, tout en
# bloquant l'envoi du cookie lors d'une navigation cross-site (CSRF).
SESSION_COOKIE_SAMESITE=Lax
# Origines autorisées à appeler l'API, séparées par des virgules.
CORS_ORIGINS=https://antivol.onrender.com

# ─── Base de données & migrations ───
# Point d'entrée CLI utilisé par `flask db ...` (ne PAS utiliser wsgi.py :
# l'importer déclencherait le bootstrap et la création de l'admin).
FLASK_APP=app:create_app
# URL de connexion. SQLite en local, PostgreSQL en production.
# DATABASE_URL=sqlite:///antivol.db

# ─── Compte administrateur (création initiale) ───
# Le compte n'est plus codé en dur. Renseignez ces variables UNE fois pour
# créer le compte, puis SUPPRIMEZ ADMIN_PASSWORD de l'environnement et
# conservez uniquement ADMIN_PASSWORD_MIGRATION le jour où vous voulez
# changer le mot de passe (puis supprimez-la aussi).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOM=Administrateur
ADMIN_PRENOM=Antivol
# ADMIN_TELEPHONE=
# Rotation ponctuelle du mot de passe administrateur (usage unique).
ADMIN_PASSWORD_MIGRATION=

# ─── Données de démonstration ───
# Créer des comptes/appareils/alertes de démonstration au premier démarrage.
# JAMAIS activer en production : ces comptes ont des mots de passe connus.
SEED_DEMO_DATA=false

# ─── Signature des commandes push ───
# Secret dedicated. Si absent, dérivé de SECRET_KEY.
COMMAND_SIGNING_KEY=

# ─── Notifications ───
# Leave vide pour utiliser https://ntfy.sh (gratuit, sans inscription).
# Pour un serveur ntfy auto-hébergé, définir NTFY_URL dans l'environnement.
NTFY_URL=https://ntfy.sh
FCM_SERVER_KEY=
# Chemin du fichier de clé, ou le JSON lui-même (Render).
FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json

# ─── SMS d'urgence (Twilio) ───
# Les trois variables doivent être définies ensemble, sinon l'envoi est
# désactivé proprement.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_API_KEY=
