<?xml version="1.0" encoding="utf-8"?>
<!--
    Le trafic en clair est INTERDIT par defaut.

    Precisement parce que l'URL du serveur est configurable dans les reglages,
    `cleartextTrafficPermitted="true"` signifiait que le mot de passe et le
    cookie de session pouvaient partir en HTTP vers n'importe quel hote : sur
    un Wi-Fi hostile, un attaquant les lisait tels quels. Le
    `<domain-config>` ci-dessous existait deja, mais il etait annule par le
    `base-config` permissif place au-dessus : le domaine le plus large
    l'emporte, donc toutcleartext etait autorise.

    Le serveur de production (antivol.onrender.com) etant en HTTPS, cela ne
    change rien a son fonctionnement.

    ATTENTION - developpement local sur reseau :
    Android n'accepte pas la notation CIDR dans `<domain>`, donc aucune plage
    privee entiere ne peut etre autorisee d'un bloc. Pour tester contre un
    serveur Flask de la maison, utilisez :
      - `adb reverse tcp:5000 tcp:5000` puis `http://localhost:5000/api` ;
      - ou ajoutez l'IP de votre machine ci-dessous, le temps du test.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <!-- Boucle locale et hote de l'emulateur : développement uniquement. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
